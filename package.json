{
  "name": "mqtt-voyager",
  "productName": "MQTT Voyager",
  "version": "0.8.0",
  "description": "MQTT Voyager is an advanced MQTT client for managing and monitoring MQTT topics and messages with ease.",
  "main": ".webpack/main",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "version": "node scripts/update-version.js",
    "bump": "node scripts/bump-version.js",
    "bump:patch": "node scripts/bump-version.js patch",
    "bump:minor": "node scripts/bump-version.js minor",
    "bump:major": "node scripts/bump-version.js major",
    "bump:rc": "node scripts/bump-version.js prerelease",
    "build:web": "webpack --config webpack.web.config.ts",
    "build:server": "tsc -p server/tsconfig.json",
    "build:docker": "npm run build:web && npm run build:server",
    "start:server": "node dist/server/server/src/index.js",
    "dev:server": "ts-node server/src/index.ts"
  },
  "keywords": [],
  "author": {
    "name": "igloo15",
    "email": "igloo15@igloo15.com"
  },
  "license": "MIT",
  "devDependencies": {
